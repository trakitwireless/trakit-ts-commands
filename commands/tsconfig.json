{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "outDir": "_publish",
        "composite": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitUseStrict": false,
        "strictNullChecks": true,
        "baseUrl": ".",
        "paths": {
            "@objects/*": ["../trakit-ts-objects/*"]
        }
    }
}