{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true, // Optionally generate types
		"declarationDir": "./_publish",
		"emitDeclarationOnly": false,
		//"rootDir": ".", // or "./commands" if you want to only emit from there
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"outDir": "./_publish", // Output directory
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitUseStrict": false,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"paths": {
			"@trakit/objects": [
				"../trakit-ts-objects/index.ts"
			]
		},
	},
	"include": [
		"./commands/index.ts"
	]
}