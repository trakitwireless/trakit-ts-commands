{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"composite": true,
		"declaration": true, // Optionally generate types
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"rootDir": ".",
		"outDir": "./_publish", // Output directory
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitUseStrict": false,
		"strictNullChecks": true,
		"paths": {
			"@trakit/objects": [
				"../trakit-ts-objects/_publish/index.d.ts"
			],
		},
	}
}